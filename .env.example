# CCA DocTrack Environment Configuration Template
# Duplicate this file as .env and replace the values with your actual configuration.

# Port for Express web server (Render sets this dynamically)
PORT=3000

# Turso Cloud Database (libSQL / SQLite)
# Create a free Turso database at https://turso.tech
# Run: turso db create cca-doctrack
# Run: turso db show cca-doctrack --url
# Run: turso db tokens create cca-doctrack
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
