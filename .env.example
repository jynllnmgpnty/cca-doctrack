# CCA DocTrack Environment Configuration Template
# Duplicate this file as .env and replace the values with your actual configuration.

# Port for Express web server (Render sets this dynamically)
PORT=3000

# Supabase PostgreSQL Configuration
# Project URL: https://<project-ref>.supabase.co
# Secret Key: Found under Project Settings -> API -> service_role key (bypasses RLS for backend server)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
